QWidget {
    background-color: #12161f;
    color: #e6edf3;
    font-family: Arial;
    font-size: 13px;
}

QPushButton {
    background-color: #238636;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: bold;}

QPushButton:hover {background-color: #2ea043;}

QPushButton#aboutBtn {background-color: #30363d;}

QPushButton#aboutBtn:hover {background-color: #484f58;}